        "justifyMode": "auto",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ]
        },
        "textMode": "auto"
      },
      "title": "Agents Evaluating",
      "targets": [
        {
          "expr": "sum(kubemoot_discussion_pending_evaluations{namespace=~\"$namespace\", crew=~\"$crew\"})",
          "legendFormat": "evaluating",
          "refId": "A"
