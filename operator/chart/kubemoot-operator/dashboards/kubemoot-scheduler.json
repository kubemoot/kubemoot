{
  "title": "Kubemoot Scheduler",
  "uid": "kubemoot-scheduler",
  "tags": [
    "kubemoot",
    "scheduler"
  ],
  "timezone": "browser",
  "schemaVersion": 39,
  "version": 1,
  "editable": true,
  "refresh": "30s",
  "time": {
    "from": "now-6h",
    "to": "now"
  },
  "panels": [
    {
      "id": 1,
      "type": "row",
      "title": "Placement",
      "collapsed": false,
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 24,
        "h": 1
      },
      "panels": []
    },
    {
      "id": 2,
      "title": "Calls by provider",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "gridPos": {
        "x": 0,
        "y": 1,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "expr": "sum by (provider) (rate(kubemoot_scheduler_calls_total{namespace=~\"$namespace\", provider=~\"$provider\"}[$__rate_interval]))",
          "legendFormat": "{{provider}}",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "reqps"
        },
        "overrides": []
      },
      "options": {},
      "description": "Model calls agents placed on each provider."
    },
    {
      "id": 3,
      "title": "Calls by kind and provider",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "gridPos": {
        "x": 12,
        "y": 1,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "expr": "sum by (kind, provider) (rate(kubemoot_scheduler_calls_total{namespace=~\"$namespace\", provider=~\"$provider\"}[$__rate_interval]))",
          "legendFormat": "{{kind}} on {{provider}}",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "reqps"
        },
        "overrides": []
      },
      "options": {},
      "description": "Tool-loop turns, advisory and synthesis calls (simple), and triage, by provider."
    },
    {
      "id": 4,
      "title": "Cold starts",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "gridPos": {
        "x": 0,
        "y": 9,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "expr": "sum by (provider, model) (rate(kubemoot_scheduler_calls_total{namespace=~\"$namespace\", provider=~\"$provider\", start=\"cold\"}[$__rate_interval]))",
          "legendFormat": "{{model}} on {{provider}}",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "reqps"
        },
        "overrides": []
      },
      "options": {},
      "description": "Calls that had to load their model first."
    },
    {
      "id": 5,
      "title": "Failed calls",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "gridPos": {
        "x": 12,
        "y": 9,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "expr": "sum by (provider, model) (rate(kubemoot_scheduler_calls_total{namespace=~\"$namespace\", provider=~\"$provider\", outcome=\"failed\"}[$__rate_interval]))",
          "legendFormat": "{{model}} on {{provider}}",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "reqps"
        },
        "overrides": []
      },
      "options": {}
    },
    {
      "id": 6,
      "type": "row",
      "title": "Speed",
      "collapsed": false,
      "gridPos": {
        "x": 0,
        "y": 17,
        "w": 24,
        "h": 1
      },
      "panels": []
    },
    {
      "id": 7,
      "title": "Call duration",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "gridPos": {
        "x": 0,
        "y": 18,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "expr": "sum by (provider, model) (rate(kubemoot_scheduler_call_seconds_sum{namespace=~\"$namespace\", provider=~\"$provider\"}[$__rate_interval])) / (sum by (provider, model) (rate(kubemoot_scheduler_call_seconds_count{namespace=~\"$namespace\", provider=~\"$provider\"}[$__rate_interval])) > 0)",
          "legendFormat": "mean: {{model}} on {{provider}}",
          "refId": "A"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "expr": "histogram_quantile(0.95, sum by (le, provider, model) (rate(kubemoot_scheduler_call_seconds_bucket{namespace=~\"$namespace\", provider=~\"$provider\"}[$__rate_interval])))",
          "legendFormat": "p95: {{model}} on {{provider}}",
          "refId": "B"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "s"
        },
        "overrides": []
      },
      "options": {}
    },
    {
      "id": 8,
      "title": "Generation speed of crew calls",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "gridPos": {
        "x": 12,
        "y": 18,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "expr": "sum by (provider, model) (rate(kubemoot_scheduler_generated_tokens_total{namespace=~\"$namespace\", provider=~\"$provider\"}[$__rate_interval])) / (sum by (provider, model) (rate(kubemoot_scheduler_generate_seconds_total{namespace=~\"$namespace\", provider=~\"$provider\"}[$__rate_interval])) > 0)",
          "legendFormat": "{{model}} on {{provider}}",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "none"
        },
        "overrides": []
      },
      "options": {},
      "description": "Tokens per second the engines generated for crew calls."
    },
    {
      "id": 9,
      "title": "Waits for capacity",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "gridPos": {
        "x": 0,
        "y": 26,
        "w": 24,
        "h": 8
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "expr": "sum by (provider, model) (rate(kubemoot_scheduler_capacity_wait_seconds_count{namespace=~\"$namespace\", provider=~\"$provider\", outcome=\"placed\"}[$__rate_interval]))",
          "legendFormat": "placed: {{model}} on {{provider}}",
          "refId": "A"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "expr": "sum by (model) (rate(kubemoot_scheduler_capacity_wait_seconds_count{namespace=~\"$namespace\", outcome=\"not_placed\"}[$__rate_interval]))",
          "legendFormat": "not placed: {{model}}",
          "refId": "B"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "expr": "histogram_quantile(0.95, sum by (le, model) (rate(kubemoot_scheduler_capacity_wait_seconds_bucket{namespace=~\"$namespace\"}[$__rate_interval])))",
          "legendFormat": "p95 wait (s): {{model}}",
          "refId": "C"
        }
      ],
      "fieldConfig": {
        "defaults": {},
        "overrides": []
      },
      "options": {},
      "description": "Calls that waited for an accelerator with room: placed waits by where they were placed, and waits that ended without a placement."
    },
    {
      "id": 10,
      "type": "row",
      "title": "Placement policy",
      "collapsed": false,
      "gridPos": {
        "x": 0,
        "y": 34,
        "w": 24,
        "h": 1
      },
      "panels": []
    },
    {
      "id": 11,
      "title": "Shadow decisions",
      "type": "piechart",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "gridPos": {
        "x": 0,
        "y": 35,
        "w": 8,
        "h": 8
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "expr": "sum by (agreement) (increase(kubemoot_scheduler_shadow_decisions_total{namespace=~\"$namespace\"}[$__range]))",
          "legendFormat": "{{agreement}}",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {},
        "overrides": []
      },
      "options": {},
      "description": "In shadow mode, how the learned policy's choice compared with the algorithm's, over the time range."
    },
    {
      "id": 12,
      "title": "Shadow decisions over time",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "gridPos": {
        "x": 8,
        "y": 35,
        "w": 16,
        "h": 8
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "expr": "sum by (agreement) (rate(kubemoot_scheduler_shadow_decisions_total{namespace=~\"$namespace\"}[$__rate_interval]))",
          "legendFormat": "{{agreement}}",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {},
        "overrides": []
      },
      "options": {}
    },
    {
      "id": 13,
      "title": "Calls by placement policy",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "gridPos": {
        "x": 0,
        "y": 43,
        "w": 24,
        "h": 8
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "expr": "sum by (policy) (rate(kubemoot_scheduler_calls_total{namespace=~\"$namespace\", provider=~\"$provider\"}[$__rate_interval]))",
          "legendFormat": "{{policy}}",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {},
        "overrides": []
      },
      "options": {}
    },
    {
      "id": 14,
      "type": "row",
      "title": "Model providers",
      "collapsed": false,
      "gridPos": {
        "x": 0,
        "y": 51,
        "w": 24,
        "h": 1
      },
      "panels": []
    },
    {
      "id": 15,
      "title": "Calibration",
      "type": "table",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "gridPos": {
        "x": 0,
        "y": 52,
        "w": 8,
        "h": 8
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "expr": "max by (provider, phase) (kubemoot_provider_calibration_phase{provider=~\"$provider\"} == 1)",
          "legendFormat": "",
          "refId": "A",
          "instant": true,
          "format": "table"
        }
      ],
      "fieldConfig": {
        "defaults": {},
        "overrides": []
      },
      "options": {},
      "description": "Each provider's current calibration phase."
    },
    {
      "id": 16,
      "title": "Calibrated and observed speed",
      "type": "table",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "gridPos": {
        "x": 8,
        "y": 52,
        "w": 16,
        "h": 8
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "expr": "max by (provider, model, kind, source) (kubemoot_provider_model_tokens_per_second{provider=~\"$provider\"})",
          "legendFormat": "",
          "refId": "A",
          "instant": true,
          "format": "table"
        }
      ],
      "fieldConfig": {
        "defaults": {},
        "overrides": []
      },
      "options": {},
      "description": "Tokens per second by model: calibrated, and observed from crew calls that ran alone since the calibration."
    },
    {
      "id": 17,
      "title": "Load time",
      "type": "table",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "gridPos": {
        "x": 0,
        "y": 60,
        "w": 8,
        "h": 8
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "expr": "max by (provider, model) (kubemoot_provider_model_load_seconds{provider=~\"$provider\"})",
          "legendFormat": "",
          "refId": "A",
          "instant": true,
          "format": "table"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "s"
        },
        "overrides": []
      },
      "options": {}
    },
    {
      "id": 18,
      "title": "Drifted models",
      "type": "table",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "gridPos": {
        "x": 8,
        "y": 60,
        "w": 16,
        "h": 8
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "expr": "max by (provider, model) (kubemoot_provider_model_drifted{provider=~\"$provider\"} == 1)",
          "legendFormat": "",
          "refId": "A",
          "instant": true,
          "format": "table"
        }
      ],
      "fieldConfig": {
        "defaults": {},
        "overrides": []
      },
      "options": {},
      "description": "Models whose crew calls drifted from their calibration; the scheduling crew is asked to judge each drift."
    }
  ],
  "annotations": {
    "list": [
      {
        "builtIn": 1,
        "datasource": {
          "type": "grafana",
          "uid": "-- Grafana --"
        },
        "enable": true,
        "hide": true,
        "iconColor": "rgba(0, 211, 255, 1)",
        "name": "Annotations & Alerts",
        "type": "dashboard"
      }
    ]
  },
  "templating": {
    "list": [
      {
        "name": "datasource",
        "label": "Data source",
        "type": "datasource",
        "query": "prometheus",
        "current": {},
        "refresh": 1
      },
      {
        "name": "namespace",
        "label": "Crew namespace",
        "type": "query",
        "datasource": {
          "type": "prometheus",
          "uid": "${datasource}"
        },
        "query": {
          "query": "label_values({__name__=~\"kubemoot_.+\"}, namespace)",
          "refId": "namespaces"
        },
        "definition": "label_values({__name__=~\"kubemoot_.+\"}, namespace)",
        "includeAll": true,
        "multi": true,
        "allValue": ".*",
        "refresh": 2,
        "sort": 1,
        "current": {
          "selected": true,
          "text": [
            "All"
          ],
          "value": [
            "$__all"
          ]
        }
      },
      {
        "name": "provider",
        "label": "Provider",
        "type": "query",
        "datasource": {
          "type": "prometheus",
          "uid": "${datasource}"
        },
        "query": {
          "query": "label_values({__name__=~\"kubemoot_scheduler_calls_total|kubemoot_provider_calibration_phase\"}, provider)",
          "refId": "providers"
        },
        "definition": "label_values({__name__=~\"kubemoot_scheduler_calls_total|kubemoot_provider_calibration_phase\"}, provider)",
        "includeAll": true,
        "multi": true,
        "allValue": ".*",
        "refresh": 2,
        "sort": 1,
        "current": {
          "selected": true,
          "text": [
            "All"
          ],
          "value": [
            "$__all"
          ]
        }
      }
    ]
  }
}
