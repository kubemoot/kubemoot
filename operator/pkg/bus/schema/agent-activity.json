{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "AgentActivity",
  "description": "One busy agent in an activity event.",
  "type": "object",
  "required": ["agent", "doing"],
  "properties": {
    "agent": { "type": "string", "description": "The agent." },
    "doing": {
      "type": "string",
      "enum": ["waking", "triaging", "evaluating", "waiting_for_accelerator", "reasoning", "waiting_for_agents", "synthesizing"],
      "description": "What the agent is doing."
    },
    "gpu": { "type": "string", "description": "The accelerator it runs on." },
    "model": { "type": "string", "description": "The model it waits for." },
    "since": { "type": "string", "description": "When it started this step, RFC 3339 in UTC." }
  }
}
