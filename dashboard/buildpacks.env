# Build-time variables for the Paketo Node.js buildpacks (paketo-build-args.sh reads this
# file; `pack build --env-file buildpacks.env` takes it too).
# The Node.js major, equal to .nvmrc (a test checks that they agree).
BP_NODE_VERSION=26.*
# npm ci runs first, then this script builds the SvelteKit adapter-node server into build/.
BP_NODE_RUN_SCRIPTS=build
# Start the Procfile process directly, with no shell.
BP_DIRECT_PROCESS=true
# The package.json start script (the same `node build` as the Procfile) is what makes the
# Paketo npm-start buildpack require node and node_modules at launch; without it only the
# build would hold them. With both required, the buildpack copies node_modules to the
# launch layer and runs npm prune there, so the image keeps no devDependencies. That prune
# is the buildpack default; no BP_ variable switches it.
# Node.js sets NODE_ENV=production at launch by default; this states it.
BPE_NODE_ENV=production
# The server's listening address, as the Dockerfile set it (the chart also maps port 3000).
BPE_PORT=3000
BPE_HOST=0.0.0.0
