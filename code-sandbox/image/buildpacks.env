# Build-time variables for the Paketo Python buildpacks (paketo-build-args.sh reads this
# file). The Go server is built static in CI and packaged next to this directory's files;
# the buildpacks add the Python the sandbox runs programs with.
# The Python the sandbox runs agents' programs with. runtime_contract_test.go holds the CI
# interpreter (setup-python in ci-code-sandbox.yaml) and this value to the same minor.
BP_CPYTHON_VERSION=3.14.*
# The Procfile starts the server under tini, which reaps the processes a killed program
# leaves behind (without it they stay as zombies under the server for the life of the pod).
BP_LAUNCH_WITH_TINI=true
BP_DIRECT_PROCESS=true
